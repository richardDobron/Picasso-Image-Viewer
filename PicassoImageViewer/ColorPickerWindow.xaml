<Window
    x:Class="PicassoImageViewer.ColorPickerWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:c="clr-namespace:PicassoImageViewer.Controls"
    xmlns:local="clr-namespace:PicassoImageViewer"
    mc:Ignorable="d"
    Title="ColorPickerWindow"
    WindowStyle="None"
    Width="300"
    Height="390"
    ResizeMode="NoResize"
    Topmost="True"
    AllowsTransparency="True"
    Background="Transparent"
    MouseLeftButtonDown="WindowMouseLeftButtonDown">
    <Border
        Margin="8"
        CornerRadius="12"
        Background="#E61E1E1E"
        BorderBrush="#BF191919"
        BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition
                    Height="Auto" />
                <RowDefinition
                    Height="*" />
            </Grid.RowDefinitions>

            <Grid
                Grid.Row="0"
                Margin="24,24,24,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition
                        Width="*" />
                    <ColumnDefinition
                        Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock
                        x:Name="titleLabel"
                        Text="Color Picker"
                        Foreground="#FFFDFDFD"
                        FontSize="22"
                        FontWeight="SemiBold" />
                    <TextBlock
                        x:Name="instructionsLabel"
                        Text="Click the image to sample a color from the current view."
                        Foreground="#D8D8D8"
                        FontSize="13"
                        TextWrapping="Wrap"
                        Margin="0,6,0,0" />
                </StackPanel>

                <Button
                    Grid.Column="1"
                    Style="{StaticResource NativeButtonStyle}"
                    Width="40"
                    Height="40"
                    Margin="12,0,0,0"
                    Cursor="Hand"
                    Click="CloseButtonClick"
                    VerticalAlignment="Top">
                    <Path
                        Fill="#FFF5F5F5"
                        Width="16"
                        Height="16"
                        Data="{StaticResource IconClose}"
                        Stretch="Fill" />
                </Button>
            </Grid>


            <StackPanel
                Grid.Row="1"
                Margin="18,18,18,18">
                <Border
                    x:Name="swatchBorder"
                    Width="120"
                    Height="120"
                    Margin="0,16,0,0"
                    CornerRadius="8"
                    BorderBrush="#60FFFFFF"
                    BorderThickness="1"
                    Background="#FF000000" />
                <TextBlock
                    x:Name="valueLabel"
                    Margin="0,16,0,0"
                    Foreground="White"
                    FontFamily="Segoe UI Semibold"
                    FontSize="14"
                    Text="Selected: 0, 0, 0"
                    HorizontalAlignment="Center" />
                <TextBlock
                    x:Name="rgbLabel"
                    Margin="0,6,0,0"
                    Foreground="#FFD2D2D2"
                    FontFamily="Segoe UI"
                    FontSize="13"
                    Text="RGB: 0, 0, 0"
                    HorizontalAlignment="Center" />
                <TextBlock
                    x:Name="hexLabel"
                    Margin="0,6,0,0"
                    Foreground="#FFD2D2D2"
                    FontFamily="Segoe UI"
                    FontSize="13"
                    Text="Hex: #000000"
                    HorizontalAlignment="Center" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
