<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWPF>true</UseWPF>
    <LangVersion>latest</LangVersion>
    <RootNamespace>PicassoImageViewer</RootNamespace>
    <AssemblyName>picasso</AssemblyName>
    <ApplicationIcon>favicon.ico</ApplicationIcon>
    <StartupObject>PicassoImageViewer.App</StartupObject>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <!-- App.xaml.cs defines its own Main (single-instance handling). -->
    <EnableDefaultApplicationDefinition>false</EnableDefaultApplicationDefinition>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="Microsoft.VisualBasic" />
    <Reference Include="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="favicon.ico" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="MainWindow.*.cs">
      <DependentUpon>MainWindow.xaml</DependentUpon>
    </Compile>
    <Compile Update="Properties\Resources.Designer.cs">
      <AutoGen>True</AutoGen>
      <DesignTime>True</DesignTime>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
    <EmbeddedResource Update="Properties\Resources.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>

  <Target Name="CopyLocalizedResourcesToInstallerLayout" AfterTargets="Build">
    <PropertyGroup>
      <LocalizedResourcesDir>$(TargetDir)cs</LocalizedResourcesDir>
      <InstallerI18nDir>$(TargetDir)i18n</InstallerI18nDir>
    </PropertyGroup>
    <MakeDir Directories="$(InstallerI18nDir)" Condition="Exists('$(LocalizedResourcesDir)')" />
    <Copy SourceFiles="$(LocalizedResourcesDir)\$(AssemblyName).resources.dll" DestinationFiles="$(InstallerI18nDir)\cs.dll" Condition="Exists('$(LocalizedResourcesDir)\$(AssemblyName).resources.dll')" />
  </Target>

</Project>
