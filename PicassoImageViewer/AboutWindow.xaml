<Window
    x:Class="PicassoImageViewer.AboutWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="clr-namespace:PicassoImageViewer"
    mc:Ignorable="d"
    Title="About Picasso Image Viewer"
    WindowStyle="None"
    WindowStartupLocation="CenterScreen"
    Width="540"
    Height="280"
    Topmost="True"
    AllowsTransparency="True"
    Background="Transparent">
    <Grid>
        <Border
            Margin="8"
            CornerRadius="12"
            Background="#E61E1E1E"
            BorderBrush="#BF191919"
            BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition
                        Height="Auto" />
                    <RowDefinition
                        Height="*" />
                    <RowDefinition
                        Height="Auto" />
                </Grid.RowDefinitions>

                <Grid
                    Grid.Row="0"
                    Margin="24,24,24,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition
                            Width="*" />
                        <ColumnDefinition
                            Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock
                            Text="Picasso Image Viewer"
                            Foreground="#FFFDFDFD"
                            FontSize="22"
                            FontWeight="SemiBold" />
                        <TextBlock
                            Text="A powerful local image viewer."
                            Foreground="#D8D8D8"
                            FontSize="13"
                            TextWrapping="Wrap"
                            Margin="0,6,0,0" />
                    </StackPanel>

                    <Button
                        x:Name="closeBtn"
                        Grid.Column="1"
                        Style="{StaticResource NativeButtonStyle}"
                        Width="40"
                        Height="40"
                        Margin="12,0,0,0"
                        Cursor="Hand"
                        VerticalAlignment="Top">
                        <Path
                            Fill="#FFF5F5F5"
                            Width="16"
                            Height="16"
                            Data="{StaticResource IconClose}"
                            Stretch="Fill" />
                    </Button>
                </Grid>

                <Border
                    Grid.Row="1"
                    Margin="24,18,24,0"
                    Padding="14"
                    Background="#22000000"
                    BorderBrush="#33FFFFFF"
                    BorderThickness="1"
                    CornerRadius="6">
                    <StackPanel>
                        <TextBlock
                            Text="Licensed under the MIT License"
                            Foreground="#FFFFFF"
                            FontSize="13"
                            FontWeight="SemiBold" />
                        <TextBlock
                            Text="• Built with .NET and WPF"
                            Foreground="#D4D4D4"
                            FontSize="12"
                            Margin="0,4,0,0"
                            TextWrapping="Wrap" />
                        <TextBlock
                            Text="• Designed and implemented by Richard Dobroň"
                            Foreground="#D4D4D4"
                            FontSize="12"
                            Margin="0,4,0,0"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <StackPanel
                    Grid.Row="2"
                    Orientation="Horizontal"
                    Margin="24,14,24,24"
                    VerticalAlignment="Center">
                    <TextBlock
                        Text="Version:"
                        Foreground="#B9B9B9"
                        FontSize="12"
                        Margin="0,0,6,0" />
                    <TextBlock
                        x:Name="versionLabel"
                        Foreground="#FFFFFF"
                        FontSize="12"
                        Text="Not released" />
                    <TextBlock
                        Text="•"
                        Foreground="#7F7F7F"
                        Margin="10,0,8,0" />
                    <Button
                        x:Name="githubLabel"
                        Style="{StaticResource LinkButtonStyle}"
                        Foreground="#FF5EB6FF"
                        Content="Github"
                        Cursor="Hand" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
