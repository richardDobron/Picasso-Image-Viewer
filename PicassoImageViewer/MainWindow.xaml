<Window
    x:Class="PicassoImageViewer.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="clr-namespace:PicassoImageViewer"
    mc:Ignorable="d"
    WindowStyle="None"
    WindowState="Maximized"
    Width="1024"
    Height="768"
    Title="Picasso Image Viewer"
    AllowsTransparency="True"
    Background="#7F000000"
    AllowDrop="True"
    Closing="WindowClosing"
    MouseWheel="WindowMouseWheel"
    Drop="WindowDrop"
    PreviewKeyDown="WindowPreviewKeyDown">
    <Window.Resources>
        <Style
            TargetType="ToolTip">
            <Setter
                Property="Template">
                <Setter.Value>
                    <ControlTemplate
                        TargetType="ToolTip">
                        <Grid>
                            <Border
                                Background="#7F000000"
                                BorderBrush="#BF191919"
                                BorderThickness="1">
                                <Label
                                    Foreground="#99FFFFFF"
                                    Content="{TemplateBinding Content}" />
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid
        x:Name="mainGrid"
        MouseMove="MainGridMouseMove"
        MouseLeftButtonUp="MainGridMouseLeftButtonUp"
        MouseLeave="MainGridMouseLeave">
        <Border
            x:Name="slideshowBackdrop"
            Background="Black"
            Opacity="0"
            IsHitTestVisible="False" />
        <Image
            x:Name="image"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Stretch="Uniform"
            MouseLeftButtonDown="MainGridMouseLeftButtonDown"
            Cursor="Hand">
            <Image.Effect>
                <DropShadowEffect
                    Color="Black"
                    ShadowDepth="0"
                    BlurRadius="22"
                    Opacity="0.4" />
            </Image.Effect>
        </Image>
        <Border
            x:Name="zoomOverlay"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Background="#8C000000"
            BorderThickness="1"
            CornerRadius="4"
            Padding="8,4"
            Visibility="Collapsed"
            IsHitTestVisible="False">
            <TextBlock
                x:Name="zoomOverlayText"
                Foreground="#FFF2F2F2"
                FontFamily="Segoe UI Semibold"
                FontSize="16"
                Text="100%" />
        </Border>
        <Grid
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Margin="30">
            <StackPanel
                Orientation="Horizontal">
                <Button
                    x:Name="openBtn"
                    Style="{StaticResource NativeButtonWithShadowStyle}"
                    Height="40"
                    Padding="8,0"
                    Margin="0,0,6,0"
                    FontFamily="Segoe UI Light"
                    FontSize="16"
                    Content="OPEN"
                    Cursor="Hand"
                    Click="OpenButtonClick" />

                <Button
                    x:Name="infoBtn"
                    Style="{StaticResource NativeButtonWithShadowStyle}"
                    Width="40"
                    Height="40"
                    ToolTip="Information"
                    ToolTipService.InitialShowDelay="1000"
                    ToolTipService.ShowDuration="2500"
                    ToolTipService.BetweenShowDelay="0"
                    Cursor="Hand">
                    <Path
                        Fill="{Binding ElementName=infoBtn, Path=Foreground}"
                        Width="22"
                        Height="22"
                        Data="{StaticResource IconInfo}"
                        Stretch="Fill" />
                </Button>
            </StackPanel>
        </Grid>

        <Button
            x:Name="closeBtn"
            Style="{StaticResource NativeButtonWithShadowStyle}"
            Width="40"
            Height="40"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            Margin="30"
            ToolTip="Close"
            ToolTipService.InitialShowDelay="1000"
            ToolTipService.ShowDuration="2500"
            ToolTipService.BetweenShowDelay="0"
            Cursor="Hand"
            Click="CloseButtonClick">
            <Path
                Fill="{Binding ElementName=closeBtn, Path=Foreground}"
                Width="16"
                Height="16"
                Data="{StaticResource IconClose}"
                Stretch="Fill" />
        </Button>

        <Grid
            x:Name="grid"
            Width="300"
            Height="300"
            HorizontalAlignment="Center"
            VerticalAlignment="Center">
            <Label
                x:Name="noSelectedImageLabel"
                Foreground="#FFF5F5F5"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                FontFamily="Segoe UI Light"
                FontSize="18"
                Content="SELECT AN IMAGE FIRST" />
            <Button
                x:Name="openPromptText"
                Style="{StaticResource LinkButtonStyle}"
                Foreground="#FFD1D1D1"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Margin="0,60,0,0"
                FontFamily="Segoe UI Semibold"
                FontSize="18"
                Content="OPEN"
                Click="OpenButtonClick"
                Cursor="Hand" />
        </Grid>
        <Label
            x:Name="currentImageNameLabel"
            Foreground="#FFFFFF"
            HorizontalAlignment="Center"
            VerticalAlignment="Bottom"
            Margin="30,0,30,115"
            FontFamily="Segoe UI Bold"
            FontSize="12"
            HorizontalContentAlignment="Center">
            <Label.Effect>
                <DropShadowEffect
                    Color="Black"
                    Direction="0"
                    ShadowDepth="0"
                    BlurRadius="35"
                    RenderingBias="Performance" />
            </Label.Effect>
        </Label>
        <Border
            x:Name="navigation"
            HorizontalAlignment="Center"
            VerticalAlignment="Bottom"
            Margin="30,0,30,73"
            Background="#4C000000"
            BorderBrush="#66191919"
            BorderThickness="1"
            CornerRadius="4"
            Padding="4"
            Visibility="Collapsed">
            <StackPanel
                Orientation="Horizontal">
                <Button
                    x:Name="prevImageBtn"
                    Style="{StaticResource NativeButtonWithShadowStyle}"
                    Width="32"
                    Height="32"
                    ToolTip="Previous Photo"
                    ToolTipService.IsEnabled="False"
                    MouseEnter="NavigationButtonMouseEnter"
                    Margin="0,0,6,0"
                    Cursor="Hand"
                    Click="PreviousImageButtonClick">
                    <Path
                        Fill="{Binding ElementName=prevImageBtn, Path=Foreground}"
                        Width="16"
                        Height="16"
                        Data="{StaticResource IconChevronLeft}"
                        Stretch="Uniform" />
                </Button>
                <Button
                    x:Name="slideshowBtn"
                    Style="{StaticResource NativeButtonWithShadowStyle}"
                    Width="32"
                    Height="32"
                    ToolTip="Play Slideshow"
                    ToolTipService.IsEnabled="False"
                    MouseEnter="NavigationButtonMouseEnter"
                    MouseLeave="NavigationButtonMouseLeave"
                    Cursor="Hand"
                    Click="SlideshowButtonClick">
                    <Path
                        x:Name="slideshowIconPath"
                        Fill="{Binding ElementName=slideshowBtn, Path=Foreground}"
                        Width="16"
                        Height="16"
                        Data="{StaticResource IconPlay}"
                        Stretch="Uniform" />
                </Button>
                <Button
                    x:Name="nextImageBtn"
                    Style="{StaticResource NativeButtonWithShadowStyle}"
                    Width="32"
                    Height="32"
                    ToolTip="Next Photo"
                    ToolTipService.IsEnabled="False"
                    MouseEnter="NavigationButtonMouseEnter"
                    MouseLeave="NavigationButtonMouseLeave"
                    Margin="6,0,0,0"
                    Cursor="Hand"
                    Click="NextImageButtonClick">
                    <Path
                        Fill="{Binding ElementName=nextImageBtn, Path=Foreground}"
                        Width="16"
                        Height="16"
                        Data="{StaticResource IconChevronRight}"
                        Stretch="Uniform" />
                </Button>
                <Button
                    x:Name="zoomInBtn"
                    Style="{StaticResource NativeButtonWithShadowStyle}"
                    Width="32"
                    Height="32"
                    Margin="6,0,0,0"
                    ToolTip="Zoom In"
                    ToolTipService.IsEnabled="False"
                    MouseEnter="NavigationButtonMouseEnter"
                    MouseLeave="NavigationButtonMouseLeave"
                    Cursor="Hand"
                    Click="ZoomInButtonClick">
                    <Path
                        Fill="{Binding ElementName=zoomInBtn, Path=Foreground}"
                        Width="16"
                        Height="16"
                        Data="{StaticResource IconZoomPlus}"
                        Stretch="Uniform" />
                </Button>
                <Button
                    x:Name="zoomReloadBtn"
                    Style="{StaticResource NativeButtonWithShadowStyle}"
                    Width="32"
                    Height="32"
                    Margin="6,0,0,0"
                    ToolTip="Zoom to 1:1"
                    ToolTipService.IsEnabled="False"
                    MouseEnter="NavigationButtonMouseEnter"
                    MouseLeave="NavigationButtonMouseLeave"
                    Cursor="Hand"
                    Click="ResetZoomButtonClick">
                    <Path
                        Fill="{Binding ElementName=zoomReloadBtn, Path=Foreground}"
                        Width="16"
                        Height="16"
                        Data="{StaticResource IconReload}"
                        Stretch="Uniform" />
                </Button>
                <Button
                    x:Name="zoomOutBtn"
                    Style="{StaticResource NativeButtonWithShadowStyle}"
                    Width="32"
                    Height="32"
                    Margin="6,0,0,0"
                    ToolTip="Zoom Out"
                    ToolTipService.IsEnabled="False"
                    MouseEnter="NavigationButtonMouseEnter"
                    MouseLeave="NavigationButtonMouseLeave"
                    Cursor="Hand"
                    Click="ZoomOutButtonClick">
                    <Path
                        Fill="{Binding ElementName=zoomOutBtn, Path=Foreground}"
                        Width="16"
                        Height="16"
                        Data="{StaticResource IconZoomMinus}"
                        Stretch="Uniform" />
                </Button>
                <Button
                    x:Name="rotateCounterClockwiseBtn"
                    Style="{StaticResource NativeButtonWithShadowStyle}"
                    Width="32"
                    Height="32"
                    Margin="6,0,0,0"
                    ToolTip="Rotate Counter-Clockwise"
                    ToolTipService.IsEnabled="False"
                    MouseEnter="NavigationButtonMouseEnter"
                    MouseLeave="NavigationButtonMouseLeave"
                    Cursor="Hand"
                    Click="RotateCounterClockwiseButtonClick">

                    <Path
                        Fill="{Binding ElementName=rotateCounterClockwiseBtn, Path=Foreground}"
                        Width="16"
                        Height="16"
                        Data="{StaticResource IconRotateLeft}"
                        Stretch="Uniform" />
                </Button>
                <Button
                    x:Name="rotateClockwiseBtn"
                    Style="{StaticResource NativeButtonWithShadowStyle}"
                    Width="32"
                    Height="32"
                    Margin="6,0,0,0"
                    ToolTip="Rotate Clockwise"
                    ToolTipService.IsEnabled="False"
                    MouseEnter="NavigationButtonMouseEnter"
                    MouseLeave="NavigationButtonMouseLeave"
                    Cursor="Hand"
                    Click="RotateClockwiseButtonClick">

                    <Path
                        Fill="{Binding ElementName=rotateClockwiseBtn, Path=Foreground}"
                        Width="16"
                        Height="16"
                        Data="{StaticResource IconRotateRight}"
                        Stretch="Uniform" />
                </Button>
                <Button
                    x:Name="colorPickerBtn"
                    Style="{StaticResource NativeButtonWithShadowStyle}"
                    Width="32"
                    Height="32"
                    Margin="6,0,0,0"
                    ToolTip="Color Picker"
                    ToolTipService.IsEnabled="False"
                    MouseEnter="NavigationButtonMouseEnter"
                    MouseLeave="NavigationButtonMouseLeave"
                    Cursor="Hand"
                    Click="OpenColorPicker">
                    <Path
                        Fill="{Binding ElementName=colorPickerBtn, Path=Foreground}"
                        Width="16"
                        Height="16"
                        Data="{StaticResource IconColorPicker}"
                        Stretch="Uniform" />
                </Button>
            </StackPanel>
        </Border>
        <Border
            x:Name="folderPanel"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Bottom"
            Margin="0,0,0,6"
            Background="#4C000000"
            BorderBrush="#66191919"
            BorderThickness="1"
            CornerRadius="4"
            Padding="6"
            MouseEnter="FolderPanelMouseEnter"
            MouseLeave="FolderPanelMouseLeave"
            PreviewMouseWheel="FolderPanelPreviewMouseWheel"
            Opacity="0"
            Visibility="Collapsed">
            <Border.RenderTransform>
                <TranslateTransform
                    x:Name="folderPanelTransform"
                    Y="24" />
            </Border.RenderTransform>
            <Grid>
                <ListBox
                    x:Name="folderImagesList"
                    Panel.ZIndex="0"
                    Background="Transparent"
                    BorderThickness="0"
                    Foreground="#FFE6E6E6"
                    HorizontalContentAlignment="Center"
                    ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                    ScrollViewer.VerticalScrollBarVisibility="Hidden"
                    ScrollViewer.CanContentScroll="True"
                    VirtualizingPanel.IsVirtualizing="True"
                    VirtualizingPanel.VirtualizationMode="Recycling"
                    VirtualizingPanel.ScrollUnit="Pixel"
                    SelectionChanged="FolderImagesListSelectionChanged">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel
                                Orientation="Horizontal"
                                HorizontalAlignment="Center" />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemContainerStyle>
                        <Style
                            TargetType="{x:Type ListBoxItem}">
                            <Setter
                                Property="Padding"
                                Value="4" />
                            <Setter
                                Property="Margin"
                                Value="2,0" />
                            <Setter
                                Property="BorderBrush"
                                Value="Transparent" />
                            <Setter
                                Property="BorderThickness"
                                Value="1" />
                            <Setter
                                Property="Background"
                                Value="Transparent" />
                            <Setter
                                Property="Template">
                                <Setter.Value>
                                    <ControlTemplate
                                        TargetType="{x:Type ListBoxItem}">
                                        <Border
                                            x:Name="itemBorder"
                                            Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            CornerRadius="3">
                                            <Grid>
                                                <ContentPresenter />
                                                <Border
                                                    x:Name="previewShade"
                                                    Background="#73000000"
                                                    Opacity="0.5"
                                                    IsHitTestVisible="False" />
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger
                                                Property="IsSelected"
                                                Value="True">
                                                <Setter
                                                    TargetName="itemBorder"
                                                    Property="BorderBrush"
                                                    Value="#FFCDCDCD" />
                                                <Setter
                                                    TargetName="itemBorder"
                                                    Property="Background"
                                                    Value="#2AFFFFFF" />
                                            </Trigger>

                                            <DataTrigger
                                                Binding="{Binding IsMouseOver, ElementName=folderPanel}"
                                                Value="True">
                                                <DataTrigger.EnterActions>
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation
                                                                Storyboard.TargetName="previewShade"
                                                                Storyboard.TargetProperty="Opacity"
                                                                To="0"
                                                                Duration="0:0:0.4" />
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </DataTrigger.EnterActions>
                                                <DataTrigger.ExitActions>
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation
                                                                Storyboard.TargetName="previewShade"
                                                                Storyboard.TargetProperty="Opacity"
                                                                To="0.5"
                                                                Duration="0:0:0.4" />
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </DataTrigger.ExitActions>
                                            </DataTrigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
            </Grid>
        </Border>
    </Grid>
</Window>
